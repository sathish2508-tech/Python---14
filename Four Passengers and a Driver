def number_of_cars_needed(no_of_people):
    if (no_of_people % 5 == 0):
        no_of_cars = no_of_people // 5
    else:
        no_of_cars = (no_of_people // 5) + 1 
    return no_of_cars
    # Complete this function


no_of_people = int(input())
cars = number_of_cars_needed(no_of_people)
print(cars)
