def count_the_vowels(word):
    count = 0
    for i in word:
        if (i == "a" or i == "e" or i == "i" or i == "o" or i == "u"):
            count += 1 
    return count
    # Complete this function


word = input().lower()
is_vowel = count_the_vowels(word)
print(is_vowel)
