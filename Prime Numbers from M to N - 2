def check_is_prime(m, n):
    prime = ""
    
    for i in range(m, n + 1):
        if i <= 1:
            continue
        factors = 0
        for j in range(2, i):
            if i % j == 0:
                factors += 1 
        if factors == 0:
            prime += str(i) + " "
    return prime
    # complete this function
    
m = int(input())
n = int(input())

prime_numbers = check_is_prime(m,n)  # Call the check_is_prime function

print(prime_numbers)
