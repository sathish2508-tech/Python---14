def is_prime(n):
    values = ""
    for i in range(2,n+1):
        factor = 0
        for j in range(2,i):
            if i % j == 0:
                factor += 1 
        if factor == 0:
            values += str(i) + " "
    return values
    # complete this function


n = int(input())
string = is_prime(n)
# call the is_prime function
print(string)
