def get_first_upper_letter(string):
    result = ""
    for char in string:
        upper_case = char.upper()
        if char == upper_case:
            result = char 
            return result
    # complete this function


string = input()
upper_case_character = get_first_upper_letter(string) # call the get_first_upper_letter function
print(upper_case_character)
